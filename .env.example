# ============================================================================
#  VIGIA WEB AUDIT - Variables de entorno
#  Copia este archivo como `.env` y rellena los valores reales.
#  Todas las variables son validadas al arrancar (src/config/env.ts).
# ============================================================================

# --- Aplicacion ---
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=debug
# Version de prueba: los planes se muestran pero el alta de pago no se habilita
# (solo informativo). Pon true cuando las pasarelas esten listas.
PAID_OPTIONS_ENABLED=false

# --- Base de datos (PostgreSQL / Supabase) ---
# Supabase: Project Settings > Database > Connection string (URI)
DATABASE_URL="postgresql://postgres:password@localhost:5432/vigia?schema=public"

# ============================================================================
#  PAGOS  (elige un proveedor: stripe | paddle)
# ============================================================================
# IMPORTANTE para Panama: Stripe NO admite cuentas comerciales panameñas.
# Para facturar desde Panama usa PAYMENT_PROVIDER=paddle (Merchant of Record).
# Si quieres Stripe nativo, constituye una LLC en EE.UU. (Stripe Atlas).
PAYMENT_PROVIDER=paddle

# --- Opcion A: Paddle (recomendado para Panama) ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=production
# priceId de cada plan creado en Paddle (Paddle > Catalog > Prices)
PADDLE_PRICE_ID=
PADDLE_PRICE_ID_PRO=
PADDLE_PRICE_ID_AGENCY=

# --- Opcion B: Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_AGENCY=

# --- Correo transaccional (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Vigia Web Audit <informes@tudominio.com>"
EMAIL_REPLY_TO=soporte@tudominio.com
ADMIN_NOTIFICATION_EMAIL=tu-correo@tudominio.com

# --- IA (Anthropic Claude / OpenAI) ---
# Deja vacio el que no uses. Si ambos estan vacios, se usa un generador local.
AI_PROVIDER=auto            # auto | anthropic | openai
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
AI_MODEL=
AI_MAX_TOKENS=1500

# --- Auditoria ---
PAGESPEED_API_KEY=
AUDIT_TIMEOUT_MS=20000
MAX_AUDIT_CONCURRENCY=4

# --- Cron / automatizacion ---
# En la nube con cron jobs separados (Render/Railway), deja esto en false.
CRON_ENABLED=true
CRON_SCHEDULE=0 8 * * 1
CRON_TIMEZONE=America/Panama

# --- Seguridad ---
ADMIN_API_TOKEN=cambia-esto-por-un-token-largo-y-secreto
# Secreto para firmar los enlaces del portal. Si se omite, usa ADMIN_API_TOKEN.
PORTAL_SIGNING_SECRET=cambia-esto-por-otro-secreto-largo
